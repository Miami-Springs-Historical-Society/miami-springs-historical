---
import { getCollection, render } from 'astro:content';
import { resolveEventDate } from '../utils/events';

const events = await getCollection('events');

// Resolve recurring events to their next occurrence date
const resolved = events.map(resolveEventDate);

// Filter out past one-time events at build time so they never reach the HTML.
// Recurring events are always kept — their date is recalculated client-side.
const todayET = new Date().toLocaleDateString('en-CA', { timeZone: 'America/New_York' });
const upcoming = resolved.filter(event => {
  if (event.data.recurring) return true;
  const expiry = event.data.endDate ?? event.data.date!;
  const expiryET = expiry.toLocaleDateString('en-CA', { timeZone: 'America/New_York' });
  return expiryET >= todayET;
});

const sorted = upcoming.sort((a, b) => a.data.date!.getTime() - b.data.date!.getTime());

const rendered = await Promise.all(
  sorted.map(async (event) => {
    const { Content } = await render(event);
    return { data: event.data, id: event.id, Content };
  })
);

const formatDate = (date: Date) =>
  date.toLocaleDateString(dateLocale, {
    weekday: 'long',
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'America/New_York',
  });

const formatMonth = (date: Date) =>
  date.toLocaleDateString(dateLocale, { month: 'short', timeZone: 'America/New_York' });

const formatDay = (date: Date) =>
  date.toLocaleDateString(dateLocale, { day: '2-digit', timeZone: 'America/New_York' });

const formatDateRange = (start: Date, end: Date) => {
  const opts: Intl.DateTimeFormatOptions = { month: 'long', day: 'numeric', timeZone: 'America/New_York' };
  const startStr = start.toLocaleDateString(dateLocale, opts);
  const endStr = end.toLocaleDateString(dateLocale, { day: 'numeric', timeZone: 'America/New_York' });
  const year = start.toLocaleDateString(dateLocale, { year: 'numeric', timeZone: 'America/New_York' });
  return `${startStr}–${endStr}, ${year}`;
};

import { useTranslations } from '../i18n/utils';
const t = useTranslations(Astro.currentLocale);
const dateLocale = Astro.currentLocale === 'es' ? 'es-ES' : 'en-US';
---

<section id="events" class="events-section" aria-labelledby="events-heading">
  <div class="container">
    <h2 id="events-heading" class="section-heading"><a href="#events">{t('events.heading')}</a></h2>
    <div class="divider"></div>

    {rendered.length > 0 ? (
      <ul class="events-list">
        {rendered.map(({ data, Content }) => (
          <li
            class="event-card"
            data-recurring={data.recurring ?? 'false'}
            data-recurring-start-after={data.recurringStartAfter?.toISOString().split('T')[0]}
            data-time={data.time}
          >
            <div class="event-date">
              <span class="event-month">{formatMonth(data.date!)}</span>
              <span class="event-day">{formatDay(data.date!)}</span>
            </div>
            <div class="event-info">
              <h3 class="event-title">{data.title}</h3>
              <p class="event-meta">
                <time datetime={data.date!.toISOString()}>
                  {data.endDate ? formatDateRange(data.date!, data.endDate) : formatDate(data.date!)}
                </time>
                {data.time && <> &mdash; {data.time}</>}
                {data.location && <><br />{data.location}</>}
                {data.price && <><br />{data.price}</>}
              </p>
              <div class="event-body">
                <Content />
              </div>
            </div>
          </li>
        ))}
      </ul>
    ) : (
      <p class="no-events">{t('events.none')}</p>
    )}
  </div>
</section>

<script>
  // Recalculates recurring event dates in the browser so a stale static build still
  // shows the next meeting. Same function as the build, so the two can't disagree.
  import { nextSecondTuesday } from '../utils/events';

  const dateLocale = document.documentElement.lang === 'es' ? 'es-ES' : 'en-US';

  document.querySelectorAll<HTMLElement>('.event-card').forEach(card => {
    if (card.dataset.recurring !== 'monthly-second-tuesday') return;

    const startAfterStr = card.dataset.recurringStartAfter;
    const startAfter = startAfterStr ? new Date(startAfterStr) : undefined;
    const next = nextSecondTuesday(card.dataset.time, startAfter);

    const monthEl = card.querySelector('.event-month');
    const dayEl = card.querySelector('.event-day');
    const timeEl = card.querySelector('time');
    if (monthEl) monthEl.textContent = next.toLocaleDateString(dateLocale, { month: 'short', timeZone: 'America/New_York' });
    if (dayEl) dayEl.textContent = next.toLocaleDateString(dateLocale, { day: '2-digit', timeZone: 'America/New_York' });
    if (timeEl) {
      timeEl.dateTime = next.toISOString();
      timeEl.textContent = next.toLocaleDateString(dateLocale, {
        weekday: 'long', year: 'numeric', month: 'long', day: 'numeric',
        timeZone: 'America/New_York',
      });
    }
  });
</script>

<style>
  .events-section {
    padding: 5rem 0;
    background-color: var(--color-bg-alt);
  }

  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 2rem;
  }

  .section-heading {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    color: var(--color-primary);
    margin-bottom: 1rem;
    text-align: center;
  }

  .divider {
    width: 60px;
    height: 3px;
    background-color: var(--color-accent);
    margin: 0 auto 2.5rem;
  }

  .events-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 780px;
    margin: 0 auto;
  }

  .event-card {
    display: flex;
    gap: 2rem;
    background-color: var(--color-bg);
    border: 1px solid var(--color-primary);
    padding: 1.75rem 2rem;
    align-items: flex-start;
    box-shadow: 0 2px 8px var(--color-shadow-card);
  }

  .event-date {
    flex-shrink: 0;
    text-align: center;
    background-color: var(--color-primary);
    color: var(--color-white);
    padding: 0.5rem 0.875rem;
    min-width: 60px;
  }

  .event-month {
    display: block;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-family: var(--font-body);
  }

  .event-day {
    display: block;
    font-size: 1.75rem;
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1;
  }

  .event-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--color-primary);
    margin-bottom: 0.375rem;
  }

  .event-meta {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
    font-style: italic;
  }

  .event-body {
    font-size: 0.9375rem;
    color: var(--color-text);
  }

  .no-events {
    text-align: center;
    color: var(--color-text-muted);
    font-style: italic;
    max-width: 520px;
    margin: 0 auto;
  }

  @media (max-width: 580px) {
    .event-card {
      flex-direction: column;
      gap: 1rem;
    }

    .event-date {
      align-self: flex-start;
    }
  }
</style>
