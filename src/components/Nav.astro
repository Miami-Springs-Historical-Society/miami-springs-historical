---
import generalSettings from '../data/general.json';
import { useTranslations } from '../i18n/utils';
const { pathname } = Astro.url;
const isEs = pathname.startsWith('/es');
const isMuseum = pathname.startsWith('/museum') || pathname.startsWith('/es/museum');
const t = useTranslations(Astro.currentLocale);
const base = isEs ? '/es' : '';
---

<nav aria-label={t('nav.aria_label')}>
  <div class="nav-inner">
    <a href={isEs ? '/es' : '/'} class="nav-logo">
      <img src="/favicon.svg" alt="" aria-hidden="true" class="nav-logo-mark" width="24" height="24" />
      MSHS
    </a>
    <button
      class="hamburger"
      aria-label={t('nav.open_menu')}
      aria-expanded="false"
      aria-controls="nav-menu"
      data-open-label={t('nav.open_menu')}
      data-close-label={t('nav.close_menu')}
    >
      <span></span><span></span><span></span>
    </button>
    <ul id="nav-menu" class="nav-links">
      <li><a href={`${base}/#about`}>{t('nav.about')}</a></li>
      <li><a href={`${base}/museum`} aria-current={isMuseum ? 'page' : undefined}>{t('nav.museum')}</a></li>
      <li><a href={`${base}/#history`}>{t('nav.history')}</a></li>
      <li><a href={`${base}/#events`}>{t('nav.events')}</a></li>
      <li><a href={`${base}/#connect`}>{t('nav.connect')}</a></li>
      <li><a href={`${base}/#board`}>{t('nav.board')}</a></li>
      <li class="nav-join">
        <a href={generalSettings.membership_url} target="_blank" rel="noopener noreferrer" aria-label={`${t('nav.join')} ${t('layout.opens_new_tab')}`}>{t('nav.join')}</a>
      </li>
      <li class="nav-donate">
        <a href={generalSettings.donate_url} target="_blank" rel="noopener noreferrer" aria-label={`${t('nav.donate')} ${t('layout.opens_new_tab')}`}>{t('nav.donate')}</a>
      </li>
      <li class="nav-lang">
        <a href={isEs ? '/' : '/es'} id="lang-switch">{t('nav.lang_switch')}</a>
      </li>
    </ul>
  </div>
</nav>

<script>
  const btn = document.querySelector('.hamburger') as HTMLButtonElement;
  const links = document.querySelector('.nav-links') as HTMLElement;

  btn.addEventListener('click', () => {
    const open = links.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? (btn.dataset.closeLabel ?? '') : (btn.dataset.openLabel ?? ''));
  });

  // Close menu when a link is clicked
  links.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => {
      links.classList.remove('open');
      btn.setAttribute('aria-expanded', 'false');
      btn.setAttribute('aria-label', btn.dataset.openLabel ?? '');
    });
  });

  // Store explicit language preference so the worker respects the user's choice
  document.getElementById('lang-switch')?.addEventListener('click', () => {
    const isEs = window.location.pathname.startsWith('/es');
    // Switching to English — set cookie so auto-redirect doesn't fire again
    const lang = isEs ? 'en' : 'es';
    document.cookie = `lang=${lang}; path=/; max-age=31536000; SameSite=Lax`;
  });
</script>

<style>
  nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background-color: var(--color-nav-bg);
    backdrop-filter: blur(4px);
  }

  .nav-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 3.5rem;
  }

  .nav-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--color-bg);
    text-decoration: none;
    letter-spacing: 0.15em;
    font-weight: 600;
  }

  .nav-logo-mark {
    width: 1.5rem;
    height: 1.5rem;
    display: block;
  }

  .nav-logo:hover {
    color: var(--color-white);
  }

  .nav-links {
    list-style: none;
    display: flex;
    /* The nav is capped at --max-width, so the row must fit ~1036px at any
       screen size. Spanish labels run far longer than English, so the gap and
       tracking are sized for the Spanish menu, not the English one. */
    gap: 1.15rem;
  }

  .nav-links a {
    color: var(--color-bg);
    text-decoration: none;
    white-space: nowrap;
    font-size: 0.8125rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    font-family: var(--font-body);
    transition: color 0.2s;
  }

  .nav-links a:hover {
    color: var(--color-white);
  }

  .nav-join a,
  .nav-donate a {
    color: var(--color-white) !important;
    padding: 0.3rem 0.875rem;
    letter-spacing: 0.08em;
    /* WCAG 1.4.11: the fills alone sit at 2.2-2.4:1 against the nav bar, so the
       pill boundary carries the 3:1 contrast instead (tan clears 3.6:1 against
       both fills and 8.5:1 against the bar). */
    border: 1px solid var(--color-secondary);
    transition: background-color 0.2s !important;
  }

  .nav-join a {
    background-color: var(--color-primary);
  }

  .nav-join a:hover {
    background-color: var(--color-primary-dark) !important;
    color: var(--color-white) !important;
  }

  .nav-donate a {
    background-color: var(--color-accent);
  }

  .nav-donate a:hover {
    background-color: var(--color-accent-dark) !important;
    color: var(--color-white) !important;
  }

  .nav-lang a {
    color: var(--color-secondary) !important;
  }

  .nav-lang a:hover {
    color: var(--color-white) !important;
  }

  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.25rem;
  }

  .hamburger span {
    display: block;
    width: 22px;
    height: 2px;
    background-color: var(--color-secondary);
    transition: background-color 0.2s;
  }

  .hamburger:hover span {
    background-color: var(--color-white);
  }

  @media (max-width: 560px) {
    .hamburger {
      display: flex;
    }

    .nav-links {
      display: none;
      position: absolute;
      top: 3.5rem;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      background-color: var(--color-nav-bg-mobile);
      padding: 0.5rem 0;
    }

    .nav-links.open {
      display: flex;
    }

    .nav-links li a {
      display: block;
      padding: 0.75rem 1.5rem;
      font-size: 0.875rem;
      letter-spacing: 0.08em;
    }

    /* Stacked, the two pills would otherwise sit flush and read as one
       two-tone slab. Separate them vertically only — a horizontal inset would
       push their labels off the left edge the other menu items share. */
    .nav-join a,
    .nav-donate a {
      margin: 0.25rem 0;
    }
  }
</style>
